NODE_ENV=development
PORT=4000

DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=amai_db

# Valores para AWS real. Docker Compose los reemplaza con Floci.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# COGNITO_ENDPOINT=
# COGNITO_ISSUER=
# COGNITO_JWKS_URI=

# S3 local: Compose agrega S3_BUCKET a S3_PUBLIC_ENDPOINT (sin slash final).
# Usa la IP de tu equipo en lugar de localhost para clientes en otros dispositivos.
S3_BUCKET=amaiback-plant-images
# S3_PUBLIC_ENDPOINT=http://localhost:4566
# Al ejecutar Node fuera de Compose, incluye tambien el bucket en la URL:
# S3_PUBLIC_BASE_URL=http://localhost:4566/amaiback-plant-images

ENCRYPTION_KEY=
ENCRYPTION_IV=
